rules_version = '2';

/* =========================================================
   School for Self Ascension — Firestore security rules
   ---------------------------------------------------------
   PASTE THIS INTO: Firebase console → Firestore Database → Rules → Publish.

   This file is the ONLY thing that actually protects the data. Every line of
   JavaScript on the website is public and can be edited by any visitor in
   their own browser, so nothing in js/ can be trusted to enforce anything.
   These rules run on Google's servers, where a visitor cannot reach them.

   adminUid() below is already set to Manjula's account. If her account is ever
   deleted and recreated, the UID changes: copy the new one from Firebase
   console → Authentication → Users → the "User UID" column, put it here, and
   publish again.

   Why a UID and not the email: an email can be changed by the account holder
   in some flows, and `admins` in js/config.js only decides what the screen
   shows. The UID here is the real lock.
   ========================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----- who is who ----- */
    /* Manjula's account. This single line is what separates "the school" from
       "anyone who signed up". If her account is ever recreated, the UID changes
       and this must change with it, or she loses the admin panel. */
    function adminUid() {
      return 'kjk5DnNwkDctb7nlJe6Qn7rslGg2';
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.uid == adminUid();
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /* ----- helpers ----- */
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    /* The price a visitor must pay is read from the activity document on the
       server, never taken from whatever the browser submitted. Without this a
       visitor could register for a ₹25,000 journey and write amountExpected: 1. */
    function activityPrice(activityId) {
      return get(/databases/$(database)/documents/activities/$(activityId)).data.price;
    }
    function activityIsOpen(activityId) {
      return get(/databases/$(database)/documents/activities/$(activityId)).data.registrationOpen == true;
    }

    /* Only these payment states may ever be written by a visitor.
       'paid', 'refunded' and 'waived' are claims about money arriving, and the
       only honest source for those is Manjula checking her own bank. */
    function visitorPayState(s) {
      return s in ['unpaid', 'initiated', 'claimed', 'cancelled'];
    }

    /* Facts about money arriving, which only Manjula can establish. Once a
       registration is in one of these, the visitor can no longer touch it.
       KEEP THIS LIST IDENTICAL TO `ADMIN_ONLY` in js/store.js. */
    function adminOnlyPayState(s) {
      return s in ['paid', 'refunded', 'waived', 'failed', 'expired'];
    }

    /* ---------------------------------------------------------
       SHAPE OF A REGISTRATION
       Without these a signed-in visitor could write any field they liked, at
       any size. Two things go wrong in practice. One: documents grow towards
       Firestore's 1 MiB ceiling, and since the admin panel reads the whole
       collection, enough of them make it unopenable - and nobody can delete a
       registration, so there is no way back. Two, and worse: `payment.history`
       is the audit trail Manjula reads to decide whether money arrived, so a
       registrant who can write it can plant "paid, verified by Manjula" and be
       believed.

       `size()` is NOT a string-only function in these rules - it is defined on
       lists and maps too. So `notes.size() < 2000` on its own passes a list of
       1999 long strings. Every size check below is paired with `is string`.
       --------------------------------------------------------- */
    function regFields() {
      return ['userId', 'activityId', 'activitySection', 'activityTitle',
              'dateId', 'dateLabel', 'mode', 'name', 'certName', 'email',
              'phone', 'isWhatsapp', 'address', 'notes', 'termsAccepted',
              'termsAcceptedAt', 'termsVersion', 'consentMode', 'marketingOptIn',
              'confirmedAdult', 'enteredByAdmin', 'enteredBy', 'ref', 'currency',
              'payment', 'status', 'createdAt', 'updatedAt'];
    }
    function payFields() {
      return ['method', 'state', 'amountExpected', 'amountReceived',
              'providerPaymentId', 'utr', 'verifiedBy', 'verifiedAt',
              'notes', 'history'];
    }
    function addrFields() {
      return ['line1', 'line2', 'city', 'state', 'pin', 'country'];
    }

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    /* Every free-text field a person can type, bounded. The numbers are
       generous for real answers and useless for filling a database. */
    function regTextIsSane(d) {
      return shortText(d.name, 120)
        && shortText(d.certName, 120)
        && shortText(d.email, 200)
        && shortText(d.phone, 30)
        && shortText(d.notes, 2000)
        && shortText(d.activityId, 120)
        && shortText(d.activityTitle, 200)
        && shortText(d.activitySection, 40)
        && shortText(d.dateId, 60)
        && shortText(d.dateLabel, 120)
        && shortText(d.mode, 40)
        && shortText(d.ref, 40)
        && shortText(d.currency, 8)
        && shortText(d.status, 20)
        && shortText(d.termsVersion, 40)
        && shortText(d.consentMode, 20)
        && shortText(d.enteredBy, 200)
        && d.address.keys().hasOnly(addrFields())
        && shortText(d.address.line1, 200)
        && shortText(d.address.line2, 200)
        && shortText(d.address.city, 100)
        && shortText(d.address.state, 100)
        && shortText(d.address.pin, 20)
        && shortText(d.address.country, 100)
        && d.payment.keys().hasOnly(payFields())
        && shortText(d.payment.method, 40)
        && shortText(d.payment.state, 20)
        && shortText(d.payment.utr, 60)
        && shortText(d.payment.verifiedBy, 200)
        && shortText(d.payment.notes, 500)
        && shortText(d.payment.providerPaymentId, 120)
        && d.keys().hasOnly(regFields());
    }

    /* Bounds for the homepage content. Generous for real prose, useless for
       filling a database. Lists are capped because they render as cards and a
       hundred of them would be a broken page, not a feature. */
    function contentIsSane(d) {
      return (!('hero' in d) || (d.hero.keys().hasOnly(['sub']) && shortText(d.hero.sub, 400)))
        && (!('quote' in d) || (d.quote.keys().hasOnly(['text', 'attrib', 'image'])
              && shortText(d.quote.text, 600) && shortText(d.quote.attrib, 120) && shortText(d.quote.image, 200)))
        && (!('about' in d) || (d.about.keys().hasOnly(['creds', 'lead', 'muted'])
              && shortText(d.about.creds, 400) && shortText(d.about.lead, 800) && shortText(d.about.muted, 800)))
        && (!('healing' in d) || (d.healing is list && d.healing.size() <= 8))
        /* 12 products, because .col-grid is three columns: that is four tidy
           rows, and these cards are enquiry categories rather than a catalogue. */
        && (!('apothecary' in d) || (d.apothecary.keys().hasOnly(['steps', 'products', 'intro'])
              && (!('steps' in d.apothecary) || d.apothecary.steps.size() <= 6)
              && (!('products' in d.apothecary) || d.apothecary.products.size() <= 12)))
        && (!('film' in d) || (d.film.keys().hasOnly(['url', 'poster', 'published', 'heading'])
              && shortText(d.film.url, 400) && shortText(d.film.poster, 200) && shortText(d.film.heading, 200)));
    }

    /* =====================================================
       activities — the workshops shown on the website
       Anyone may read (the public site lists them).
       Only Manjula may create, change or delete one.
       ===================================================== */
    match /activities/{activityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* =====================================================
       content — the words and pictures on the homepage
       Anyone may read: the public site renders from it.
       Only Manjula may write, and only within sane bounds. A content document
       is a few kilobytes of prose; the caps exist so a mistake, or a stolen
       session, cannot grow it towards Firestore's 1 MiB ceiling in a document
       every single visitor downloads on every visit.
       ===================================================== */
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && docId == 'site'
        && incoming().keys().hasOnly(['hero', 'quote', 'healing', 'about',
                                      'apothecary', 'film', 'updatedAt'])
        && contentIsSane(incoming());
    }

    /* =====================================================
       users — one small profile document per account
       Readable and writable only by that person.
       ===================================================== */
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && incoming().keys().hasOnly(['name', 'email', 'phone', 'createdAt'])
        && shortText(incoming().name, 120)
        && shortText(incoming().email, 200)
        && shortText(incoming().phone, 30);
      allow delete: if isOwner(uid) || isAdmin();
    }

    /* =====================================================
       registrations — the personal data that matters most
       ===================================================== */
    match /registrations/{regId} {

      /* READ: you see your own. Manjula sees everyone's.
         Without the second clause nobody could run the school; without the
         first, anyone signed in could read every registrant's phone number
         and home address, which is the worst outcome this system can have. */
      allow read: if isAdmin() || isOwner(existing().userId);

      /* CREATE by Manjula — someone who booked over WhatsApp, typed in by hand.
         The open-registration and price checks are visitor protections and do
         not apply to her: she is often entering exactly the booking that came
         in after a workshop closed, at a fee she agreed herself. What still
         holds is that she cannot conjure a record that is already paid. */
      allow create: if isAdmin()
        && incoming().userId == request.auth.uid
        && incoming().payment.state == 'unpaid'
        && incoming().status == 'pending'
        && incoming().payment.amountReceived == null
        && incoming().payment.verifiedBy == ''
        && regTextIsSane(incoming());

      /* CREATE: a signed-in person registering themselves. */
      allow create: if isSignedIn()
        /* you may only create a registration that belongs to you */
        && incoming().userId == request.auth.uid
        /* the activity must exist and be open */
        && activityIsOpen(incoming().activityId)
        /* a new registration always starts unpaid and pending — you cannot
           create one that is already marked paid */
        && incoming().payment.state == 'unpaid'
        && incoming().status == 'pending'
        && incoming().payment.amountReceived == null
        && incoming().payment.verifiedBy == ''
        /* the amount owed must match the real price of the activity */
        && incoming().payment.amountExpected == activityPrice(incoming().activityId)
        /* consent has to actually be recorded */
        && incoming().termsAccepted == true
        && incoming().termsVersion is string
        && incoming().confirmedAdult == true
        /* and may not dress their own registration up as one Manjula entered */
        && incoming().enteredByAdmin == false
        && incoming().enteredBy == ''
        /* 'ticked' is what actually happened here: they ticked the box. Only
           Manjula may record 'verbal', because only she can have heard it. */
        && incoming().consentMode == 'ticked'
        /* The audit trail starts empty of claims. Without this a registration
           can be born carrying a forged "paid" entry. */
        && incoming().payment.history.size() == 1
        && incoming().payment.history[0].state == 'unpaid'
        && incoming().payment.utr == ''
        && incoming().payment.notes == ''
        && incoming().payment.verifiedAt == ''
        /* every field named, typed and bounded */
        && incoming().name.size() > 0
        && regTextIsSane(incoming());

      /* UPDATE by the person who registered.
         They may do exactly two things: say they have started paying, say they
         have paid and give a reference, or cancel. They may never change the
         amount, the activity, their own verified status, or anyone's name. */
      allow update: if isOwner(existing().userId)
        && incoming().userId == existing().userId
        && incoming().activityId == existing().activityId
        && incoming().ref == existing().ref
        && incoming().payment.amountExpected == existing().payment.amountExpected
        /* the money facts stay exactly as they were */
        && incoming().payment.amountReceived == existing().payment.amountReceived
        && incoming().payment.verifiedBy == existing().payment.verifiedBy
        && incoming().payment.verifiedAt == existing().payment.verifiedAt
        /* The state check fires only when the state actually changes. Checked
           unconditionally it would reject an ordinary edit — correcting a phone
           number — purely because Manjula had already marked the record paid. */
        && (incoming().payment.state == existing().payment.state
            || visitorPayState(incoming().payment.state))
        && incoming().status in ['pending', 'cancelled']
        /* Once Manjula has settled the money, the visitor is out. Checking only
           for 'paid' let someone walk a waived or refunded record back to
           'claimed' and re-open a question that was closed. */
        && !adminOnlyPayState(existing().payment.state)
        /* The consent record is evidence, not a preference. These are what the
           school would have to produce if a registration were ever disputed, so
           they are fixed at the moment of registering. Name, email, phone,
           address, notes and marketing choice stay editable — those are the
           registrant's own details and they should be able to correct them. */
        && incoming().termsAccepted == existing().termsAccepted
        && incoming().termsAcceptedAt == existing().termsAcceptedAt
        && incoming().termsVersion == existing().termsVersion
        && incoming().consentMode == existing().consentMode
        && incoming().confirmedAdult == existing().confirmedAdult
        && incoming().enteredByAdmin == existing().enteredByAdmin
        && incoming().enteredBy == existing().enteredBy
        && incoming().activityTitle == existing().activityTitle
        && incoming().createdAt == existing().createdAt
        /* The audit trail is Manjula's record of what happened, so a registrant
           must not be able to plant an entry reading "paid, by
           archangelg9@gmail.com" - which is exactly what she reads when
           deciding whether money arrived.

           But it cannot simply be frozen either. Saying "I have paid" is the
           one thing a visitor is supposed to do here, and setPaymentState
           appends an entry every time, so freezing it refused the UPI claim
           outright: the person who had just sent money was told they did not
           have permission.

           So: append-only, one entry at a time, everything before it
           untouched, and the new entry must say by:'visitor' and must match
           the state being set - which visitorPayState already limits to the
           four a visitor may write. The length cap matters because nothing
           paid can be deleted, so an unbounded history is a way to grow a
           document towards the 1 MiB ceiling by claiming and cancelling. */
        && (incoming().payment.history == existing().payment.history
            || (incoming().payment.history.size() == existing().payment.history.size() + 1
                && incoming().payment.history.size() <= 40
                && incoming().payment.history[0:existing().payment.history.size()] == existing().payment.history
                && incoming().payment.history[existing().payment.history.size()].by == 'visitor'
                && incoming().payment.history[existing().payment.history.size()].state == incoming().payment.state))
        && incoming().payment.notes == existing().payment.notes
        && incoming().payment.providerPaymentId == existing().payment.providerPaymentId
        && incoming().payment.method == existing().payment.method
        /* and the record cannot be grown or reshaped on the way through */
        && regTextIsSane(incoming());

      /* UPDATE by Manjula — she is the one who reconciles money, so she may
         write the states nobody else can. */
      allow update: if isAdmin();

      /* A registration that money has touched is evidence, and deleting it
         would leave a person who paid with no proof. Those can only ever be
         cancelled, which keeps the history.

         Everything else - a never-paid record, which is what spam and mistakes
         look like - Manjula may remove. Without this there is no way to clear
         junk out of a collection the admin panel reads in full, and a flood
         would be permanent. */
      allow delete: if isAdmin()
        && existing().payment.state == 'unpaid'
        && existing().payment.amountReceived == null
        && existing().payment.verifiedBy == '';
    }

    /* Anything not named above is closed. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
